<view class="page {{shakeActive ? 'page--shake' : ''}}">
  <view class="hud">
    <view class="stat">
      <text class="stat-label">雷数</text>
      <text class="stat-value">{{remainingMines}}</text>
    </view>
    <button class="reset-button" bindtap="handleReset">重新开始</button>
    <view class="stat">
      <text class="stat-label">用时</text>
      <text class="stat-value">{{elapsed}}s</text>
    </view>
  </view>

  <view class="status-message">{{statusMessage}}</view>

  <view
    class="board {{dimBoard ? 'board--dim' : ''}}"
    style="width: {{boardPixelSize}}rpx; grid-template-columns: repeat({{width}}, {{cellOuterSize}}rpx); grid-auto-rows: {{cellOuterSize}}rpx;"
  >
    <block wx:for="{{displayGrid}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="index">
      <block wx:for="{{row}}" wx:for-item="cell" wx:key="id">
        <view
          class="cell cell--{{cell.state}} {{cell.numberClass}}"
          data-row="{{cell.row}}"
          data-col="{{cell.col}}"
          bindtap="handleCellTap"
          bindlongpress="handleCellLongPress"
          style="width: {{cellOuterSize}}rpx; height: {{cellOuterSize}}rpx; animation-delay: {{cell.revealDelay || 0}}ms;"
        >
          <text wx:if="{{cell.text}}">{{cell.text}}</text>
          <view wx:if="{{cell.exploding}}" class="cell-explosion"></view>
        </view>
      </block>
    </block>
  </view>

  <view wx:if="{{flashActive}}" class="flash-overlay"></view>

  <view wx:if="{{winCelebration}}" class="win-overlay">
    <view class="win-banner">成功啦！</view>
    <view class="win-fireworks">
      <block wx:for="{{5}}" wx:key="index">
        <view class="firework firework--{{index}}"></view>
      </block>
    </view>
    <view class="win-confetti">
      <block wx:for="{{30}}" wx:key="index">
        <view class="confetti confetti--{{index % 5}}"></view>
      </block>
    </view>
  </view>

  <view class="rules">
    <view class="rule-item">
      <text class="rule-key">单击</text>
      <text class="rule-value">翻开方块，首击不会遇雷</text>
    </view>
    <view class="rule-item">
      <text class="rule-key">长按</text>
      <text class="rule-value">空白 → 🚩 → ❓ 循环</text>
    </view>
    <view class="rule-item">
      <text class="rule-key">双击数字</text>
      <text class="rule-value">周围旗帜数等于数字时自动翻开剩余邻格；若误标旗会踩雷。</text>
    </view>
    <view class="rule-item">
      <text class="rule-key">胜利</text>
      <text class="rule-value">所有非雷格翻开即可胜利，雷可未插旗。</text>
    </view>
    <view class="rule-item">
      <text class="rule-key">失败</text>
      <text class="rule-value">翻到雷或快速开误触雷，将显示全部雷并标出错旗。</text>
    </view>
  </view>
</view>
