.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 48rpx 24rpx 64rpx;
  transition: transform 0.2s ease;
}

.page--shake {
  animation: page-shake 500ms ease-in-out;
}

.hud {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  gap: 10rpx;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.3);
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(8rpx);
}

.stat {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #f8fafc;
}

.stat-label {
  opacity: 0.8;
  font-size: 28rpx;
}

.stat-value {
  min-width: 60rpx;
  text-align: center;
}

.reset-button {
  min-width: 160rpx;
  border-radius: 12rpx;
  background: #38bdf8;
  color: #0f172a;
  font-weight: 600;
  border: none;
}

.status-message {
  min-height: 48rpx;
  font-size: 28rpx;
  color: rgba(226, 232, 240, 0.8);
}

.board {
  display: grid;
  grid-gap: 0;
  justify-content: center;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 4rpx solid #7b7b7b;
  background: #bdbdbd;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.3);
}

.board--dim {
  filter: grayscale(0.7);
  opacity: 0.75;
  transition: filter 400ms ease, opacity 400ms ease;
}

.rules {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.25);
  background: rgba(15, 23, 42, 0.55);
  color: rgba(226, 232, 240, 0.9);
  font-size: 26rpx;
}

.rules-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #f8fafc;
}

.rule-item {
  display: flex;
  gap: 13rpx;
}

.rule-key {
  min-width: 128rpx;
  font-weight: 600;
  color: #38bdf8;
}

.rule-value {
  flex: 1;
  line-height: 1.4;
}

.cell {
  margin: 0;
  border: 4rpx solid;
  border-color: #f8fafc #4b5563 #4b5563 #f8fafc;
  background: #bdbdbd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 28rpx;
  color: #111827;
  position: relative;
  overflow: hidden;
}

.cell text {
  line-height: 1;
}

.cell--revealed,
.cell--blank {
  border: 2rpx solid #7b7b7b;
  background: #d1d5db;
}

.cell--mine {
  background: #dc2626;
  color: #f8fafc;
  border: 2rpx solid #991b1b;
}

.cell--number {
  border: 2rpx solid #7b7b7b;
  background: #d1d5db;
}

.cell--flag {
  color: #dc2626;
}

.cell--question {
  color: #facc15;
}

.cell--mistake {
  background: #1f2933;
  color: #f87171;
  border: 2rpx solid #ef4444;
}

.cell--exploded {
  background: #b91c1c;
  color: #f8fafc;
  border: 2rpx solid #7f1d1d;
}

.cell-explosion {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.8);
  transform: translate(-50%, -50%);
  animation: explosion-pulse 650ms ease-out forwards;
  pointer-events: none;
}

.cell--num-1 { color: #1d4ed8; }
.cell--num-2 { color: #15803d; }
.cell--num-3 { color: #b91c1c; }
.cell--num-4 { color: #1e293b; }
.cell--num-5 { color: #7f1d1d; }
.cell--num-6 { color: #0f766e; }
.cell--num-7 { color: #111827; }
.cell--num-8 { color: #6b7280; }

.win-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 6;
}

.win-banner {
  font-size: 64rpx;
  font-weight: 800;
  color: #f8fafc;
  text-shadow: 0 6rpx 12rpx rgba(15, 23, 42, 0.6);
  letter-spacing: 4rpx;
  animation: win-pop 1200ms ease-out;
}

.win-fireworks,
.win-confetti {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.firework {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  opacity: 0;
  animation: firework-burst 1200ms ease-out infinite;
}

.firework--0 { top: 30%; left: 20%; background: #38bdf8; animation-delay: 0s; }
.firework--1 { top: 28%; right: 18%; background: #f472b6; animation-delay: 0.2s; }
.firework--2 { bottom: 32%; left: 25%; background: #facc15; animation-delay: 0.3s; }
.firework--3 { bottom: 30%; right: 22%; background: #34d399; animation-delay: 0.45s; }
.firework--4 { top: 18%; left: 48%; background: #c084fc; animation-delay: 0.6s; }

.win-confetti .confetti {
  position: absolute;
  top: -10%;
  width: 8rpx;
  height: 22rpx;
  border-radius: 4rpx;
  animation: confetti-fall 1800ms linear forwards;
}

.confetti--0 { background: #facc15; left: 5%; animation-delay: 0s; }
.confetti--1 { background: #38bdf8; left: 15%; animation-delay: 0.1s; }
.confetti--2 { background: #f472b6; left: 30%; animation-delay: 0.2s; }
.confetti--3 { background: #34d399; left: 45%; animation-delay: 0.3s; }
.confetti--4 { background: #c084fc; left: 60%; animation-delay: 0.4s; }
.win-confetti .confetti:nth-child(odd) { transform: rotate(12deg); }
.win-confetti .confetti:nth-child(even) { transform: rotate(-16deg); }

.flash-overlay {
  position: fixed;
  inset: 0;
  background: rgba(239, 68, 68, 0.3);
  pointer-events: none;
  animation: flash-blink 350ms ease-in-out 0s 2;
  z-index: 5;
}

@keyframes page-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-8rpx);
  }
  40% {
    transform: translateX(6rpx);
  }
  60% {
    transform: translateX(-4rpx);
  }
  80% {
    transform: translateX(2rpx);
  }
}

@keyframes explosion-pulse {
  0% {
    width: 20%;
    height: 20%;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.9);
    opacity: 0.9;
  }
  60% {
    width: 140%;
    height: 140%;
    box-shadow: 0 0 30rpx 10rpx rgba(248, 250, 252, 0.4);
    opacity: 0.5;
  }
  100% {
    width: 180%;
    height: 180%;
    box-shadow: 0 0 40rpx 16rpx rgba(15, 23, 42, 0.2);
    opacity: 0;
  }
}

@keyframes flash-blink {
  0% {
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}

@keyframes win-pop {
  0% {
    transform: scale(0.6);
    opacity: 0;
  }
  45% {
    transform: scale(1.1);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes firework-burst {
  0% {
    transform: scale(0.4);
    opacity: 0;
  }
  20% {
    transform: scale(1.4);
    opacity: 1;
  }
  60% {
    transform: scale(2);
    opacity: 0.7;
  }
  100% {
    transform: scale(2.8);
    opacity: 0;
  }
}

@keyframes confetti-fall {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 1;
  }
  80% {
    opacity: 1;
  }
  100% {
    transform: translateY(120%) rotate(360deg);
    opacity: 0;
  }
}
