.page {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 48rpx 24rpx 64rpx;
}

.hud {
  width: 100%;
  max-width: 640rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.3);
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(8rpx);
}

.stat {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #f8fafc;
}

.stat-label {
  opacity: 0.8;
  font-size: 28rpx;
}

.stat-value {
  min-width: 60rpx;
  text-align: center;
}

.reset-button {
  min-width: 160rpx;
  border-radius: 12rpx;
  background: #38bdf8;
  color: #0f172a;
  font-weight: 600;
  border: none;
}

.status-message {
  min-height: 48rpx;
  font-size: 28rpx;
  color: rgba(226, 232, 240, 0.8);
}

.board {
  display: grid;
  justify-content: center;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 4rpx solid #7b7b7b;
  background: #bdbdbd;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.3);
}

.cell {
  margin: 0;
  border: 4rpx solid;
  border-color: #f8fafc #4b5563 #4b5563 #f8fafc;
  background: #bdbdbd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 28rpx;
  color: #111827;
}

.cell text {
  line-height: 1;
}

.cell--revealed,
.cell--blank {
  border: 2rpx solid #7b7b7b;
  background: #d1d5db;
}

.cell--flag {
  color: #ef4444;
}

.cell--mine {
  background: #dc2626;
  color: #f8fafc;
  border: 2rpx solid #991b1b;
}

.cell--number {
  border: 2rpx solid #7b7b7b;
  background: #d1d5db;
}

.cell--num-1 { color: #1d4ed8; }
.cell--num-2 { color: #15803d; }
.cell--num-3 { color: #b91c1c; }
.cell--num-4 { color: #1e293b; }
.cell--num-5 { color: #7f1d1d; }
.cell--num-6 { color: #0f766e; }
.cell--num-7 { color: #111827; }
.cell--num-8 { color: #6b7280; }
